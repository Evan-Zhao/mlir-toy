// RUN: neptune-lsp-server --lit-test < %s | FileCheck %s
{"jsonrpc":"2.0","id":0,"method":"initialize","params":{"processId":123,"rootPath":".","capabilities":{},"trace":"off"}}
// -----
{"jsonrpc":"2.0","method":"textDocument/didOpen","params":{"textDocument":{"uri":"test:///ta.mlir","languageId":"mlir","version":1,"text":"func.func @minimal_ta(%tensor: tensor<16xf32>) -> tensor<16xf32> {\n  %0 = ta.scope axes(%coord \"i\" extent 16) {\n    %1 = ta.at %tensor[%coord] : tensor<16xf32> -> !ta.expr<f32, [i]>\n    %2 = ta.reduce #ta.reduce_kind<add> %1 {axes = #ta.axes<i>} : !ta.expr<f32, [i]> -> !ta.expr<f32, []>\n    ta.yield %2 : !ta.expr<f32, []>\n  } : () -> tensor<16xf32>\n  return %0 : tensor<16xf32>\n}"}}}
// CHECK: "method": "textDocument/publishDiagnostics"
// CHECK: "diagnostics": []
