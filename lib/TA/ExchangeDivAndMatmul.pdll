#include "TA/TAOps.td"

Constraint DivisorAxesDisjointFromReduction(den: Value, reductionAxes: Attr) [{
  auto denType = dyn_cast<ta::ExprType>(den.getType());
  auto reducedAxes = dyn_cast<ta::AxesAttr>(reductionAxes);
  if (!denType || !reducedAxes)
    return failure();

  for (Attribute divisorAxis : denType.getAxes().getAxes()) {
    auto divisorAxisAttr = cast<ta::AxisAttr>(divisorAxis);
    for (Attribute reducedAxis : reducedAxes.getAxes()) {
      auto reducedAxisAttr = cast<ta::AxisAttr>(reducedAxis);
      if (divisorAxisAttr.getName() == reducedAxisAttr.getName())
        return failure();
    }
  }
  return success();
}];

Constraint AddReduceKind(kind: Attr) [{
  auto reduceKind = dyn_cast<ta::ReduceKindAttr>(kind);
  return success(reduceKind && reduceKind.getValue() == ta::ReduceKind::Add);
}];

Pattern ExchangeDivAndMatmul {
  let axes: Attr;
  let kind: Attr;
  let resultType: Type;

  let div = op<ta.divf>(num: Value, den: Value) {"ta.import_group" = sourceNum1: Attr};
  let prod = op<ta.mulf>(div, rhs: Value) {"ta.import_group" = sourceNum2: Attr};
  let reduce = op<ta.reduce>(prod) {kind = kind, axes = axes, "ta.import_group" = sourceNum3: Attr} -> (resultType);
  DivisorAxesDisjointFromReduction(den, axes);
  AddReduceKind(kind);

  rewrite reduce with {
    let newProd = op<ta.mulf>(num, rhs) {"ta.import_group" = sourceNum2};
    let newReduce = op<ta.reduce>(newProd) {kind = kind, axes = axes, "ta.import_group" = sourceNum3} -> (resultType);
    replace reduce with op<ta.divf>(newReduce, den) {"ta.import_group" = sourceNum1};
  };
}
